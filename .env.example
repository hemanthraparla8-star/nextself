AI_SERVER_PORT=3001
AI_SERVER_HOST=0.0.0.0
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
EXPOSE_ERROR_DETAILS=false

# Set this to use real AI responses. Keep it only on the backend.
AI_PROVIDER=gemini

# Free-tier friendly option from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Set false when GEMINI_API_KEY or OPENAI_API_KEY is configured and you want real API calls.
NEXTSELF_USE_MOCK_AI=true

# Expo app clients use this URL.
# Production / public testing:
EXPO_PUBLIC_AI_API_URL=https://nextself-ai-backend.onrender.com

# Optional: switch the Expo app from the hosted backend to Firebase AI Logic.
# Keep as "backend" until Firebase AI Logic is enabled in the Firebase console.
EXPO_PUBLIC_AI_PROVIDER=backend
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDtksrb4rTOCt0UEEwlfS6PzFnjgLPTed0
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nextself-93b1a.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nextself-93b1a
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nextself-93b1a.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=355855691335
EXPO_PUBLIC_FIREBASE_APP_ID=1:355855691335:web:56f82c06cf016371b2cb62
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-MDDGLQQJ65
EXPO_PUBLIC_FIREBASE_AI_MODEL=gemini-2.5-flash

# Web/iOS simulator on same machine:
# EXPO_PUBLIC_AI_API_URL=http://localhost:3001

# Android emulator commonly needs:
# EXPO_PUBLIC_AI_API_URL=http://10.0.2.2:3001

# Physical phone on same Wi-Fi needs your computer LAN IP:
# EXPO_PUBLIC_AI_API_URL=http://192.168.x.x:3001

# Published app needs a deployed HTTPS backend:
# EXPO_PUBLIC_AI_API_URL=https://api.yourdomain.com
