{
  "expo": {
    "name": "NextSelf",
    "slug": "nextself",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E0E10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nextself.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10"
      },
      "package": "com.nextself.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NextSelf to access your photos for AI analysis."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NextSelf to use your camera for face scans and skincare routine analysis."
        }
      ],
      "expo-font"
    ]
  }
}
